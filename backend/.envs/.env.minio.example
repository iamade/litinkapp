# KAN-402: dedicated MinIO container env file.
#
# This file is read ONLY by the `minio` service in local.yml / production.yml.
# It exists so the container's MINIO_ROOT_USER / MINIO_ROOT_PASSWORD can be
# kept in sync with the app's MINIO_ACCESS_KEY / MINIO_SECRET_KEY (which
# live in .env.local / .env.staging / etc.) without leaking DB creds, API
# keys, and other secrets into the MinIO container's process env.
#
# The values below must match what the api service is configured with
# (see MINIO_ACCESS_KEY / MINIO_SECRET_KEY in the api env file). After a
# `docker compose down -v` the container recreates with these creds, so
# the app and container always agree.
#
# To use a different remote MinIO cluster with custom root creds, override
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD here AND MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY in the api env file. They MUST move together.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
