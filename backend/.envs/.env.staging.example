# KAN-264 / KAN-402: Staging media path isolation
# Copy this to .env.staging and fill in real values.
# Staging must use an externally reachable public URL for provider callbacks/fetch-backs.
# KAN-402: MINIO_ROOT_USER / MINIO_ROOT_PASSWORD are the container-side
# credentials the local MinIO container is started with. They must match
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY so that a `docker compose down -v`
# reset can never desync app auth from container auth.
MINIO_BUCKET_NAME=litinkai-staging
MINIO_PUBLIC_URL=https://minio-staging.litinkai.com:8443
MINIO_PROVIDER_PUBLIC_URL=https://minio-staging.litinkai.com:8443
MODELSLAB_MEDIA_PUBLIC_URL=https://minio-staging.litinkai.com:8443
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# All other vars: copy from .env.local (API keys, DB creds, etc.)
# KAN-401 script/free fallback providers
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
Z_AI_FREE_MODEL=glm-5.2
PIAPI_API_KEY_LITINKAI=
PIAPI_BASE_URL=https://api.piapi.ai/v1
PIAPI_FREE_MODEL=gpt-4o-mini
FEATHERLESS_API_KEY_LITINKAI=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_FREE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
